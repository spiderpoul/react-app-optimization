{
  "name": "react-app-optimization",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "classnames": "2.5.1",
    "copy-webpack-plugin": "12.0.2",
    "core-js": "3.38.1",
    "cors": "2.8.5",
    "express-slow-down": "2.0.3",
    "html-webpack-plugin": "5.6.0",
    "react": "18.3.1",
    "react-content-loader": "6.2.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "react-stack-grid": "0.7.1",
    "styled-components": "6.1.13",
    "three": "0.157.0",
    "typescript": "5.6.2",
    "web-vitals": "4.2.3"
  },
  "scripts": {
    "start": "nodemon  --exec \"npm run build && npm run server\" --watch ./ --watch ../shared -e js,ts,tsx,css,scss --ignore ./build",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "start-nginx": "docker run -it --rm --name react_nginx -p 8081:80  -m 512m --memory-reservation=256m  --cpu-quota=10000 react_nginx",
    "start-express": "docker run -it --rm --name react_express -p 8080:8080  -m 512m --memory-reservation=256m  --cpu-quota=5000 react_express",
    "start-final": "docker run -it --rm --name react_final -p 8082:80  -m 512m --memory-reservation=256m  --cpu-quota=10000 react_final",
    "build-nginx": "cd ../ && docker build -t react_nginx -f nginx.Dockerfile .",
    "build-express": "cd ../ && docker build -t react_express -f express.Dockerfile .",
    "build-final": "cd ../ && docker build -t react_final -f nginx.Dockerfile .",
    "server": "node server",
    "build-analyze": "cross-env ANALYZE=1 webpack --config webpack.config.js",
    "dev-server": "webpack serve --config webpack.config.js"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.4",
    "@babel/preset-react": "7.24.7",
    "@babel/preset-typescript": "7.24.7",
    "@statoscope/webpack-plugin": "5.28.2",
    "@svgr/webpack": "8.1.0",
    "@types/webpack": "5.28.5",
    "babel-loader": "9.2.1",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "mini-css-extract-plugin": "2.9.1",
    "nodemon": "3.1.7",
    "sass": "1.79.3",
    "sass-loader": "16.0.2",
    "style-loader": "4.0.0",
    "svg-url-loader": "8.0.0",
    "ts-loader": "9.5.1",
    "url-loader": "4.1.1",
    "webpack": "5.94.0",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.1.0"
  }
}